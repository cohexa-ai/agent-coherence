{
  "name": "workspace-restore-member-after-another-controller-registered",
  "description": "#191, the delete half of a registration has the commit half's gate: B registers a restore of a receiver-less checkpoint and so claims it; C's member write is then refused `already_registered`, which names nobody.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ]
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      },
      {
        "method": "POST",
        "path": "/workspace/restore/register",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "checkpoint_id": "${checkpoint}",
          "writes": [
            {
              "member_path": "docs/plan.md",
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/member",
    "body": {
      "session_id": "33333333-3333-4333-8333-333333333333",
      "checkpoint_id": "${checkpoint}",
      "member_path": "docs/spec.md",
      "restore_outcome": "restored"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "already_registered",
      "detail": "restore registration of checkpoint '<UUID>' refused (already_registered): another controller already registered this checkpoint — nothing was registered",
      "member_paths": []
    }
  },
  "backends": [
    "python"
  ]
}
