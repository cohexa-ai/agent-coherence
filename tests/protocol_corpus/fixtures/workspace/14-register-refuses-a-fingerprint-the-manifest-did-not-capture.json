{
  "name": "workspace-restore-register-refuses-a-fingerprint-the-manifest-did-not-capture",
  "description": "#191 `fingerprint_mismatch`: the path IS a member, but the write carries a hash other than the one captured for it. A restore registers the captured bytes, never a caller-chosen hash.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ]
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/register",
    "body": {
      "session_id": "22222222-2222-4222-8222-222222222222",
      "checkpoint_id": "${checkpoint}",
      "writes": [
        {
          "member_path": "docs/plan.md",
          "fingerprint": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "fingerprint_mismatch",
      "detail": "restore registration of checkpoint '<UUID>' refused (fingerprint_mismatch): the write-set's fingerprints differ from the ones the manifest captured for: ['docs/plan.md'] — nothing was registered",
      "member_paths": [
        "docs/plan.md"
      ]
    }
  },
  "backends": [
    "python"
  ]
}
