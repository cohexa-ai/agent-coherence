{
  "name": "workspace-restore-status-refuses-a-non-receiver",
  "description": "#191: the progress writes are gated like the register route. C is neither the named receiver nor anyone the checkpoint admits, so it is refused with the typed `not_the_receiver` and an empty `member_paths` -- the refusal does not name the receiver. Nothing is claimed by a status write. The prose `detail` carries the checkpoint id, which the string-position scrub collapses.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ],
          "receiver_session_id": "22222222-2222-4222-8222-222222222222"
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/status",
    "body": {
      "session_id": "33333333-3333-4333-8333-333333333333",
      "checkpoint_id": "${checkpoint}",
      "status": "in_progress"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "not_the_receiver",
      "detail": "restore registration of checkpoint '<UUID>' refused (not_the_receiver): the checkpoint names a receiver and this controller is not it — nothing was registered",
      "member_paths": []
    }
  },
  "backends": [
    "python"
  ]
}
