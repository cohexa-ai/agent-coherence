{
  "name": "workspace-restore-member-of-an-unknown-member",
  "description": "A member path the manifest does not carry answers `checkpoint_unknown` -- the unknown-checkpoint token covers the (checkpoint, member) pair -- with the prose naming which.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ]
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/member",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "checkpoint_id": "${checkpoint}",
      "member_path": "docs/other.md",
      "restore_outcome": "restored"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "checkpoint_unknown",
      "detail": "member 'docs/other.md' of checkpoint '<UUID>' not in registry"
    }
  },
  "backends": [
    "python"
  ]
}
