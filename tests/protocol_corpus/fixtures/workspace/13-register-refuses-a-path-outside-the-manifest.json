{
  "name": "workspace-restore-register-refuses-a-path-outside-the-manifest",
  "description": "#191 `not_a_checkpoint_member`: a write naming a path the checkpoint never captured (the stale-id case) is refused before anything is resolved or minted, and `member_paths` names the offending write -- only the caller's own paths.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ]
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/register",
    "body": {
      "session_id": "22222222-2222-4222-8222-222222222222",
      "checkpoint_id": "${checkpoint}",
      "writes": [
        {
          "member_path": "docs/other.md",
          "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "not_a_checkpoint_member",
      "detail": "restore registration of checkpoint '<UUID>' refused (not_a_checkpoint_member): the write-set names paths the checkpoint's manifest does not describe: ['docs/other.md'] — nothing was registered",
      "member_paths": [
        "docs/other.md"
      ]
    }
  },
  "backends": [
    "python"
  ]
}
