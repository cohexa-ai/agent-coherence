{
  "name": "workspace-restore-register-retry-by-the-same-controller-is-idempotent",
  "description": "#191 retry: the controller that claimed the checkpoint re-drives the same write-set (a crash-resumed registration). It is not refused; the member already carries the manifest fingerprint from the first registration, so it is `skipped`, no version moves, `status` is `empty_write_set` (commit_all never called) -- and `retry_of_own_registration: true` is what tells \"I registered this\" from \"someone else did\".",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "33333333-3333-4333-8333-333333333333",
          "path": "docs/plan.md"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit-cas",
        "body": {
          "session_id": "33333333-3333-4333-8333-333333333333",
          "path": "docs/plan.md",
          "content_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "expected_version": 1
        }
      },
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ],
          "receiver_session_id": "22222222-2222-4222-8222-222222222222"
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      },
      {
        "method": "POST",
        "path": "/workspace/restore/register",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "checkpoint_id": "${checkpoint}",
          "writes": [
            {
              "member_path": "docs/plan.md",
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          ]
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/register",
    "body": {
      "session_id": "22222222-2222-4222-8222-222222222222",
      "checkpoint_id": "${checkpoint}",
      "writes": [
        {
          "member_path": "docs/plan.md",
          "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "checkpoint_id": "<UUID>",
      "status": "empty_write_set",
      "detail": "every written member is already registered at its manifest fingerprint — commit_all was never called",
      "versions": {},
      "skipped": [
        "docs/plan.md"
      ],
      "refused": {},
      "invalidated": 0,
      "retry_of_own_registration": true,
      "coordinator_epoch": "<MINTED>"
    }
  },
  "backends": [
    "python"
  ]
}
