{
  "name": "workspace-restore-register-of-an-empty-write-set",
  "description": "A restore that wrote no file members registers an empty write-set: `status: empty_write_set`, commit_all never called (it raises on an empty set). The #191 gates still run first -- the receiver check, then the claim -- so this is still the receiver's call to make.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/workspace/checkpoint",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "name": "before-refactor",
          "window_min": 100.0,
          "window_max": 101.0,
          "members": [
            {
              "member_path": "docs/plan.md",
              "native_token": null,
              "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            },
            {
              "member_path": "docs/spec.md",
              "native_token": null,
              "fingerprint": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "captured_at": 100.0,
              "restore_tier": "restorable-unpinned"
            }
          ],
          "receiver_session_id": "22222222-2222-4222-8222-222222222222"
        },
        "capture": {
          "checkpoint": "checkpoint_id"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/workspace/restore/register",
    "body": {
      "session_id": "22222222-2222-4222-8222-222222222222",
      "checkpoint_id": "${checkpoint}",
      "writes": []
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "checkpoint_id": "<UUID>",
      "status": "empty_write_set",
      "detail": "empty write-set: no written file members to register — commit_all was never called (it raises on an empty set)",
      "versions": {},
      "skipped": [],
      "refused": {},
      "invalidated": 0,
      "retry_of_own_registration": false,
      "coordinator_epoch": "<MINTED>"
    }
  },
  "backends": [
    "python"
  ]
}
