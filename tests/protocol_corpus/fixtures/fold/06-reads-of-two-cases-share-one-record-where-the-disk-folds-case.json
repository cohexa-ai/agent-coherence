{
  "name": "fold-reads-of-two-cases-share-one-record-where-the-disk-folds-case",
  "description": "Session A reads data/x.txt, then session B reads DATA/X.TXT; GET /status lists what each holds. On a case-insensitive disk (caseless) both read one record, listed under its stored name data/x.txt (/status lists rows, not requests). Where the disk keeps case apart (nfd, none) B's read is a second record named as B sent it. The two backends' /status envelopes differ (see warn_mode 08 and 09), so every top-level key but sessions is dropped on both sides and sessions is compared in full; agent_id is scrubbed by name. The session ids are those of the ended_attempt rows, chosen so both backends list the two agents in the same order. Both backends.",
  "setup": {
    "tracked": [
      "data/x.txt",
      "DATA/X.TXT"
    ],
    "files": {
      "data/x.txt": "x\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "99999999-9999-4999-8999-999999999999",
          "path": "data/x.txt"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "66666666-6666-4666-8666-666666666666",
          "path": "DATA/X.TXT"
        }
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/status"
  },
  "expected_by_fold_profile": {
    "caseless": {
      "status": 200,
      "body": {
        "sessions": [
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "data/x.txt": "SHARED"
            }
          },
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "data/x.txt": "SHARED"
            }
          }
        ]
      }
    },
    "nfd": {
      "status": 200,
      "body": {
        "sessions": [
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "data/x.txt": "SHARED"
            }
          },
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "DATA/X.TXT": "SHARED"
            }
          }
        ]
      }
    },
    "none": {
      "status": 200,
      "body": {
        "sessions": [
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "data/x.txt": "SHARED"
            }
          },
          {
            "agent_id": "<UUID>",
            "agent_name": null,
            "states": {
              "DATA/X.TXT": "SHARED"
            }
          }
        ]
      }
    }
  },
  "optional_keys": [
    "audit_log_mode_drift_total",
    "auth_401_total",
    "backend",
    "caller_principal_absent_total",
    "caller_principal_refused_total",
    "cold_start_duration_ms",
    "coordinator_backend",
    "coordinator_pid",
    "coordinator_root",
    "coordinator_uptime_s",
    "coordinator_uptime_seconds",
    "coordinator_version",
    "counts",
    "detail",
    "effect_fence_holds_total",
    "endpoint_counters",
    "fold_profile",
    "fold_table_unicode",
    "fresh_shared_hash_mismatch_total",
    "handler_concurrency_overflows_total",
    "handoff_giver_denials_total",
    "in_flight_drain_timed_out",
    "intra_task_acquire_release_total",
    "policy_summary",
    "pre_edit_if_unheld",
    "pre_edit_other_holder_denials_total",
    "registry_schema_version",
    "schema_version",
    "shared_foreign_lag_suppressed_total",
    "stale_warning_emitted_total",
    "stale_warning_reread_total",
    "status",
    "strict_mode_denials_total",
    "strict_mode_routed_around_via_bash_total",
    "sweep_reclaims_by_trigger",
