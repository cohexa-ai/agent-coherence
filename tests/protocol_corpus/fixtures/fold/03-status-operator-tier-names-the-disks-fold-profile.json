{
  "name": "fold-status-operator-tier-names-the-disks-fold-profile",
  "description": "GET /status?detail=full with the operator opt-in header carries the two fold fields too. The profile is the disk's, not the OS's: the harness classifies this run's own tmp workspace with the coordinators' probe and asserts the matching entry, and fails the row on a profile the map does not name. fold_table_unicode is the fold table's Unicode version, the same on every disk. Every other top-level key is dropped on both sides. Python only: the Node coordinator serves no operator tier and answers it 501.",
  "setup": {},
  "request": {
    "method": "GET",
    "path": "/status?detail=full",
    "headers": {
      "Coherence-Local-Operator": "true"
    }
  },
  "expected_by_fold_profile": {
    "caseless": {
      "status": 200,
      "body": {
        "fold_profile": "caseless",
        "fold_table_unicode": "17.0.0"
      }
    },
    "nfd": {
      "status": 200,
      "body": {
        "fold_profile": "nfd",
        "fold_table_unicode": "17.0.0"
      }
    },
    "none": {
      "status": 200,
      "body": {
        "fold_profile": "none",
        "fold_table_unicode": "17.0.0"
      }
    }
  },
  "optional_keys": [
    "audit_log_mode_drift_total",
    "auth_401_total",
    "caller_principal_absent_total",
    "caller_principal_refused_total",
    "cold_start_duration_ms",
    "coordinator_backend",
    "coordinator_pid",
    "coordinator_root",
    "coordinator_uptime_s",
    "coordinator_uptime_seconds",
    "coordinator_version",
    "detail",
    "effect_fence_holds_total",
    "endpoint_counters",
    "fresh_shared_hash_mismatch_total",
    "grant_heartbeat_timeout_sec",
    "grant_max_hold_sec",
    "handler_concurrency_overflows_total",
    "handoff_giver_denials_total",
    "in_flight_drain_timed_out",
    "intra_task_acquire_release_total",
    "policy_summary",
    "pre_edit_if_unheld",
    "pre_edit_other_holder_denials_total",
    "registry_schema_version",
    "sessions",
    "shared_foreign_lag_suppressed_total",
    "stale_warning_emitted_total",
    "stale_warning_reread_total",
    "strict_mode_denials_total",
    "strict_mode_routed_around_via_bash_total",
    "sweep_reclaims_by_trigger",
    "sweep_reclaims_total",
    "tracked_artifacts",
    "watchdog_late_aborts_total",
