{
  "name": "basis-check-proceed-with-the-registration-a-read-reported",
  "description": "PROCEED. A session read docs/plan.md with `want_registration`, kept the registration the reply carried, and later checks the file at version 1 under that registration. The registration is the row's own token, so it matches and the check answers proceed; the harness substitutes the captured value, so a coordinator that stopped accepting its own token fails here.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6",
          "want_registration": true
        },
        "capture": {
          "registration": "registration"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/basis/check",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/plan.md",
          "version": 1,
          "registration": "${registration}"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "proceed",
      "checked": {
        "docs/plan.md": {
          "expected": 1,
          "current": 1
        }
      }
    }
  },
  "backends": [
    "python"
  ]
}
