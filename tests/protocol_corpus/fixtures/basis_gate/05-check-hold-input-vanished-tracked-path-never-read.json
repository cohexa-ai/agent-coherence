{
  "name": "basis-check-hold-input-vanished-tracked-path-never-read",
  "description": "HOLD `input_vanished`. docs/other.md is tracked and exists on disk, but no session ever read it, so the coordinator has no row for it. A check resolves by lookup only: it answers a hold with a null current version and registers nothing.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/other.md": "# never read\n"
    }
  },
  "request": {
    "method": "POST",
    "path": "/basis/check",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/other.md",
          "version": 1
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "hold",
      "moved": [
        {
          "path": "docs/other.md",
          "expected": 1,
          "current": null,
          "reason": "input_vanished"
        }
      ],
      "recovery": "rederive"
    }
  },
  "backends": [
    "python"
  ]
}
