{
  "name": "basis-commit-hold-target-refused-other-holder",
  "description": "HOLD with a target block. The basis is unchanged, but a peer holds the write claim on docs/plan.md, so the target's own compare-and-swap is refused. The hold has an empty `moved` list, carries the refusal apart from the members, and names no recovery class, because re-deriving the inputs would not change the outcome.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/basis/commit",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/plan.md",
          "version": 1
        }
      ],
      "target": {
        "path": "docs/plan.md",
        "version": 1
      },
      "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "hold",
      "moved": [],
      "target": {
        "path": "docs/plan.md",
        "reason": "other_holder",
        "current_version": 1
      }
    }
  },
  "backends": [
    "python"
  ]
}
