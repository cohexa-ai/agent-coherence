{
  "name": "basis-commit-hold-basis-moved",
  "description": "HOLD `version_moved` on the commit route. The basis member moved to version 2 before the commit, so the commit answers a hold with the moved member and the class `rederive`, and the target's compare-and-swap is not attempted.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit-cas",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expected_version": 1
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/basis/commit",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/plan.md",
          "version": 1
        }
      ],
      "target": {
        "path": "docs/plan.md",
        "version": 1
      },
      "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "hold",
      "moved": [
        {
          "path": "docs/plan.md",
          "expected": 1,
          "current": 2,
          "reason": "version_moved"
        }
      ],
      "recovery": "rederive"
    }
  },
  "backends": [
    "python"
  ]
}
