{
  "name": "basis-check-hold-basis-member-replaced-different-registration",
  "description": "HOLD `basis_member_replaced`. The member sits at the row's real version 1, but the registration it carries is a different canonical UUID from the one the row has, as when a file was deleted and registered again. The versions agree, so only the registration tells the two incarnations apart; `current` equals `expected` and the reason is the replaced one.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/basis/check",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/plan.md",
          "version": 1,
          "registration": "99999999-9999-4999-8999-999999999999"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "hold",
      "moved": [
        {
          "path": "docs/plan.md",
          "expected": 1,
          "current": 1,
          "reason": "basis_member_replaced"
        }
      ],
      "recovery": "rederive"
    }
  },
  "backends": [
    "python"
  ]
}
