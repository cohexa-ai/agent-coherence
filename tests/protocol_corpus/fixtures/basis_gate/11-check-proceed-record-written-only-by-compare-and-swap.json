{
  "name": "basis-check-proceed-record-written-only-by-compare-and-swap",
  "description": "PROCEED. docs/plan.md reached version 2 through a peer's compare-and-swap alone: no session holds a write claim on it and nothing was committed through a grant. The member recorded at version 2 under the registration the first read reported still proceeds, because the compare-and-swap does not change the row's registration.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6",
          "want_registration": true
        },
        "capture": {
          "registration": "registration"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "content_hash": "f9b414ed170aade26e96b08b64710e279b57971274301dc1c4c22fb63de6eec6"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit-cas",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expected_version": 1
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/basis/check",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "basis": [
        {
          "path": "docs/plan.md",
          "version": 2,
          "registration": "${registration}"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "answer": "proceed",
      "checked": {
        "docs/plan.md": {
          "expected": 2,
          "current": 2
        }
      }
    }
  },
  "backends": [
    "python"
  ]
}
