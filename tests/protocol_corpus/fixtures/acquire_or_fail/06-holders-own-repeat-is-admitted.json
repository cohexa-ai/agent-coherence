{
  "name": "acquire-or-fail-holders-own-repeat-is-admitted",
  "description": "Session A holds EXCLUSIVE and pre-edits again with if_unheld: true. The check skips the caller's own identity, so the repeat is admitted plainly.",
  "setup": {
    "tracked": [
      "CLAUDE.md"
    ],
    "files": {
      "CLAUDE.md": "# Project rules\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "backends": [
          "python"
        ],
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "path": "CLAUDE.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
      "path": "CLAUDE.md",
      "if_unheld": true
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_a}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
