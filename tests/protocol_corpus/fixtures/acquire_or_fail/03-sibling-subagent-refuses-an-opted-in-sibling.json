{
  "name": "acquire-or-fail-sibling-subagent-refuses-an-opted-in-sibling",
  "description": "Two subagents of one session are two agents. Subagent X of session A takes EXCLUSIVE; its sibling Y opts in and is refused, naming X's composite agent id. Both name session A, so on Python both present A's principal.",
  "setup": {
    "tracked": [
      "CLAUDE.md"
    ],
    "files": {
      "CLAUDE.md": "# Project rules\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "backends": [
          "python"
        ],
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "agent_id": "a0826622451ec196f",
          "path": "CLAUDE.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
      "agent_id": "b1937733562fd2a7e",
      "path": "CLAUDE.md",
      "if_unheld": true
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_a}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "other_holder",
      "holder_agent_id": "e9bfb1f926c75c3aa47a1c904badebe4"
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
