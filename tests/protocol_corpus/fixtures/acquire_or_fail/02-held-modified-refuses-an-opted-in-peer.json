{
  "name": "acquire-or-fail-held-modified-refuses-an-opted-in-peer",
  "description": "Session A reads, pre-edits and commits CLAUDE.md, so it holds the path MODIFIED (the chain of warn_mode/36). Session B's opted-in pre-edit is refused with other_holder naming A: a committed holder is still a holder.",
  "setup": {
    "tracked": [
      "CLAUDE.md"
    ],
    "files": {
      "CLAUDE.md": "# Project rules\nv1 content\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "backends": [
          "python"
        ],
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000b",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "path": "CLAUDE.md",
          "content_hash": "2222222222222222222222222222222222222222222222222222222222222222"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "path": "CLAUDE.md"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit",
        "body": {
          "session_id": "c0c0c0c0-0000-4000-8000-00000000000a",
          "path": "CLAUDE.md",
          "success": true,
          "content_hash": "3333333333333333333333333333333333333333333333333333333333333333"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "c0c0c0c0-0000-4000-8000-00000000000b",
      "path": "CLAUDE.md",
      "if_unheld": true
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_b}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "other_holder",
      "holder_agent_id": "80cbc93dbdc35128a0f2b69566f01436"
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
