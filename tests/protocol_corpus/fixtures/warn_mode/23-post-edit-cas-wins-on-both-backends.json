{
  "name": "post-edit-cas-wins-on-both-backends",
  "description": "/hooks/post-edit-cas as the request under test (#193). The OCC flow: pre-read takes SHARED and reports version 1; the CAS carrying expected_version 1 wins and answers the new version -- no EXCLUSIVE acquire on the way.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "path": "docs/plan.md"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/post-edit-cas",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "path": "docs/plan.md",
      "content_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "expected_version": 1
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "version": 2
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
