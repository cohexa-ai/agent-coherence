{
  "name": "handoff-accept-on-a-path-with-no-record-is-refused-not-live",
  "description": "handoff_not_live, for a path that has no record at all: the refusal carries no status.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/handoff/accept",
    "body": {
      "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "path": "plan.md"
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_b}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "handoff_not_live"
    }
  },
  "backends": [
    "python"
  ]
}
