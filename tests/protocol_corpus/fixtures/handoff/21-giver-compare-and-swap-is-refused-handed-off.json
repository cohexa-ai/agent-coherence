{
  "name": "handoff-giver-compare-and-swap-is-refused-handed-off",
  "description": "handed_off on the compare-and-swap route. The giver A commits at the transfer version while its handoff is live: refused with the typed reason, the successor and the version at transfer, no hookSpecificOutput, and the handoff key.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
