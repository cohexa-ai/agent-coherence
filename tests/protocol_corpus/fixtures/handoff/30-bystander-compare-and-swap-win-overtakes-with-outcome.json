{
  "name": "handoff-bystander-compare-and-swap-win-overtakes-with-outcome",
  "description": "A bystander's compare-and-swap win. C, holding a read, commits at the transfer version past A's live handoff to B: admitted (R23), the record is labelled overtaken with C as counterparty and ends as the version moves, and the key reports the win's outcome (R24, R29).",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "mint_nonce": "corpus-mint-nonce-c"
        },
        "capture": {
          "principal_c": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_c}"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/post-edit-cas",
    "body": {
      "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "path": "plan.md",
      "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expected_version": 1
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_c}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "version": 2,
      "handoff": {
        "role": "bystander",
        "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
        "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
        "version_at_transfer": 1,
        "hold_shape": "SHARED",
        "status": "overtaken",
        "live": false,
        "counterparty": "637255db-866b-5c80-9db4-0afdc5898e12",
        "outcome": "overtaken"
      }
    }
  },
  "preserve_identity": [
    "giver",
    "successor",
    "counterparty"
  ],
  "backends": [
    "python"
  ]
}
