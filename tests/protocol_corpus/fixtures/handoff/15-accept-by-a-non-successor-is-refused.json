{
  "name": "handoff-accept-by-a-non-successor-is-refused",
  "description": "handoff_not_successor. Bystander C tries to accept A's live handoff to B; refused with the record's status, nothing changes (R20).",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "mint_nonce": "corpus-mint-nonce-c"
        },
        "capture": {
          "principal_c": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/handoff/accept",
    "body": {
      "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "path": "plan.md"
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_c}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "handoff_not_successor",
      "status": "pending"
    }
  },
  "backends": [
    "python"
  ]
}
