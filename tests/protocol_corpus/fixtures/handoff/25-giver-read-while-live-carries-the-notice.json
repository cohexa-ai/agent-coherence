{
  "name": "handoff-giver-read-while-live-carries-the-notice",
  "description": "The giver's read while its handoff is live (warn mode). The read is admitted by the ordinary rules, so today's stale-view warning comes first; the giver's notice follows it in the same envelope, and the body carries the handoff key for the giver.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-read",
    "body": {
      "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "path": "plan.md"
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_a}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "allow",
        "additionalContext": "⚠ Stale read [warning emitted <TS>]: your grant on plan.md was revoked and no new version was committed. plan.md is still at v1, the version you last saw. Re-acquire before writing to plan.md.\n\nHandoff: you handed plan.md to agent 14b6f5b5 at v1, so this session can no longer write it. The handoff ends when agent 14b6f5b5 writes plan.md, when agent 14b6f5b5 declines it, or when you withdraw it on your user's or host's instruction. Until the handoff ends, do not change plan.md by any route, a shell command included. Stop and report to your user that plan.md was handed off."
      },
      "status": "stale",
      "summary": {
        "path": "plan.md",
        "current_version": 1,
        "prior_version_seen_by_session": 1,
        "last_writer_session_id": "<unknown>",
        "last_writer_at_unix_ts": "<IGNORED>",
        "warning_generated_at_unix_ts": "<IGNORED>",
        "hash_differs": false
      },
      "handoff": {
        "role": "giver",
        "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
        "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
        "version_at_transfer": 1,
        "hold_shape": "SHARED",
        "status": "pending",
        "live": true
      }
    }
  },
  "ignore_keys": [
    "last_writer_at_unix_ts",
    "warning_generated_at_unix_ts"
  ],
  "preserve_identity": [
    "giver",
    "successor"
  ],
  "backends": [
    "python"
  ]
}
