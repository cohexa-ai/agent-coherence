{
  "name": "handoff-successor-edit-without-a-read-warns-and-completes",
  "description": "The successor's acquire without having read the path at the version at transfer. Admitted, never denied (R18); its acquire marks the record completed, still live (R21); the provenance carries the read-first warning.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "path": "plan.md"
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_b}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "handoff": {
        "role": "successor",
        "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
        "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
        "version_at_transfer": 1,
        "hold_shape": "SHARED",
        "status": "completed",
        "live": true
      },
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "additionalContext": "Handoff: agent 09f031b6 handed plan.md to this session at v1; the hold it gave up was SHARED. ⚠ You have not read plan.md at v1 or later; read it before editing."
      }
    }
  },
  "preserve_identity": [
    "giver",
    "successor"
  ],
  "backends": [
    "python"
  ]
}
