{
  "name": "handoff-resend-after-decline-answers-ended",
  "description": "handoff_ended. A re-sends a transfer B has declined, at an unmoved version: refused with the ended record's status, and nothing is written.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/decline",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_b}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/handoff/transfer",
    "body": {
      "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
      "grants": [
        {
          "path": "plan.md"
        }
      ]
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_a}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "grants": [
        {
          "path": "plan.md",
          "transferred": false,
          "reason": "handoff_ended",
          "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "version_at_transfer": 1,
          "hold_shape": "SHARED",
          "status": "declined"
        }
      ]
    }
  },
  "preserve_identity": [
    "giver",
    "successor"
  ],
  "backends": [
    "python"
  ]
}
