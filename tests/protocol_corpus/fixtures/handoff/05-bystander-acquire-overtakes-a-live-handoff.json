{
  "name": "handoff-bystander-acquire-overtakes-a-live-handoff",
  "description": "Status overtaken. While A's handoff to B is live, bystander C takes plan.md through pre-edit. It is admitted, never refused (R23), and its acquire labels the record overtaken with C as counterparty (R24). The acquire does not move the version, so the record is still live. The admitted body carries the handoff key projected for the bystander and, in a context-only envelope, the bystander advisory (R29).",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "mint_nonce": "corpus-mint-nonce-c"
        },
        "capture": {
          "principal_c": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "path": "plan.md"
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_c}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "handoff": {
        "role": "bystander",
        "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
        "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
        "version_at_transfer": 1,
        "hold_shape": "SHARED",
        "status": "overtaken",
        "live": true,
        "counterparty": "637255db-866b-5c80-9db4-0afdc5898e12"
      },
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "additionalContext": "Handoff in progress: agent 09f031b6 handed plan.md to agent 14b6f5b5 at v1. This session is not a party to it; its edits are admitted and are recorded as overtaking the handoff."
      }
    }
  },
  "preserve_identity": [
    "giver",
    "successor",
    "counterparty"
  ],
  "backends": [
    "python"
  ]
}
