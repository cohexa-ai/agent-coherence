{
  "name": "handoff-transfer-past-a-live-handoff-is-refused-in-flight",
  "description": "handoff_in_flight. C holds a standing read on plan.md while A's handoff of it to B is live; C's own transfer of the path is refused, naming the pending pair and, in static text, what ends that handoff.",
  "setup": {
    "tracked": [
      "plan.md"
    ],
    "files": {
      "plan.md": "# Plan\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "mint_nonce": "corpus-mint-nonce-a"
        },
        "capture": {
          "principal_a": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "mint_nonce": "corpus-mint-nonce-b"
        },
        "capture": {
          "principal_b": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/principal/claim",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "mint_nonce": "corpus-mint-nonce-c"
        },
        "capture": {
          "principal_c": "principal"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "path": "plan.md"
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_c}"
        }
      },
      {
        "method": "POST",
        "path": "/handoff/transfer",
        "body": {
          "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "grants": [
            {
              "path": "plan.md"
            }
          ]
        },
        "headers": {
          "Coherence-Caller-Principal": "${principal_a}"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/handoff/transfer",
    "body": {
      "session_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
      "grants": [
        {
          "path": "plan.md"
        }
      ]
    },
    "headers": {
      "Coherence-Caller-Principal": "${principal_c}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "grants": [
        {
          "path": "plan.md",
          "transferred": false,
          "reason": "handoff_in_flight",
          "giver": "09f031b6-cb23-50a2-b7a8-b405ed3810f4",
          "successor": "14b6f5b5-784c-5b3e-953a-2456d93656f9",
          "detail": "another session's handoff of this path is live; it ends when its successor declines, its giver withdraws, or any session writes the path"
        }
      ]
    }
  },
  "preserve_identity": [
    "giver",
    "successor"
  ],
  "backends": [
    "python"
  ]
}
