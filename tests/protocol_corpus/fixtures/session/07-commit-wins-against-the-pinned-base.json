{
  "name": "session-commit-wins-against-the-pinned-base",
  "description": "Begin pins docs/plan.md at version 1; a commit through the same session advances it to 2. The request carries only the token, the path and the content -- the expected version is read server-side from the cut, so no client-supplied comparand reaches the CAS (R9).",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/commit",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}",
      "path": "docs/plan.md",
      "content": "# rewritten\n"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "version": 2,
      "coordinator_epoch": "<MINTED>"
    }
  },
  "backends": [
    "python"
  ]
}
