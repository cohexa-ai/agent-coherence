{
  "name": "session-heartbeat-refreshes-and-carries-no-epoch",
  "description": "The owner's heartbeat on its live session answers `{ok: true, refreshed: true}` and, unlike begin / read / commit, carries NO `coordinator_epoch` (#193). The epoch key is scrubbed by name, not dropped, so a heartbeat that grew one would fail this row.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/heartbeat",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "refreshed": true
    }
  },
  "backends": [
    "python"
  ]
}
