{
  "name": "session-commit-all-refuses-duplicate-paths-400",
  "description": "A batch naming one path twice would collapse in the id-keyed map and turn an all-or-nothing publish into a partial one, so the boundary refuses it with HTTP 400 before the session is consulted.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/commit_all",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}",
      "writes": [
        {
          "path": "docs/plan.md",
          "content": "one\n"
        },
        {
          "path": "docs/plan.md",
          "content": "two\n"
        }
      ]
    }
  },
  "expected": {
    "status": 400,
    "body": {
      "error": "writes contains duplicate paths"
    }
  },
  "backends": [
    "python"
  ]
}
