{
  "name": "session-read-with-a-malformed-token-is-session-not-found",
  "description": "A token that is not shaped like a minted one is a different refusal from a well-formed one that names no live session: `session_not_found`, still HTTP 200 and still carrying `coordinator_epoch`. Pinned beside fixture 03 so the two reasons stay distinct on the wire.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/read",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "not-a-minted-token",
      "path": "docs/plan.md"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "session_not_found",
      "coordinator_epoch": "<MINTED>"
    }
  },
  "backends": [
    "python"
  ]
}
