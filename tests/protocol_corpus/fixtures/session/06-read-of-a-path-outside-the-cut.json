{
  "name": "session-read-of-a-path-outside-the-cut",
  "description": "A live session reading a path the coordinator has never seen answers `artifact_not_in_cut` with no `coordinator_epoch` (the handler answers before the service is asked). The path is tracked and on disk; it is simply not in this session's read set.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/read",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}",
      "path": "docs/spec.md"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "artifact_not_in_cut"
    }
  },
  "backends": [
    "python"
  ]
}
