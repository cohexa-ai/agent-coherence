{
  "name": "session-heartbeat-by-another-session-does-not-refresh",
  "description": "Session B presents A's live token. The owner binding refuses to keep another session's lease alive, and the response does not say whether the token exists: still `ok: true`, with `refreshed: false` the same as for a token that was never minted.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/heartbeat",
    "body": {
      "session_id": "22222222-2222-4222-8222-222222222222",
      "session_token": "${token}"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "refreshed": false
    }
  },
  "backends": [
    "python"
  ]
}
