{
  "name": "session-commit-after-a-peer-write-is-a-typed-conflict",
  "description": "A pins docs/plan.md at version 1; peer session B then takes the pessimistic pre-edit / post-edit path and moves it to version 2. A's commit against its pinned base is HELD with the typed conflict `{ok: false, reason, current_version}` -- no `coordinator_epoch` on this arm -- and nothing is mutated. The client's move is: open a new session, re-read, retry.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit",
        "body": {
          "session_id": "22222222-2222-4222-8222-222222222222",
          "path": "docs/plan.md",
          "success": true,
          "content_hash": "2222222222222222222222222222222222222222222222222222222222222222"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/commit",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}",
      "path": "docs/plan.md",
      "content": "# rewritten\n"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": false,
      "reason": "version_mismatch",
      "current_version": 2
    }
  },
  "backends": [
    "python"
  ]
}
