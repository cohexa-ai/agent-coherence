{
  "name": "session-commit-all-advances-every-member",
  "description": "An all-or-nothing batch over both members of the cut: each advances from its pinned version 1 to 2, reported path-keyed under `versions`.",
  "setup": {
    "tracked": [
      "docs/**"
    ],
    "files": {
      "docs/plan.md": "# coherence corpus fixture  \n",
      "docs/spec.md": "# coherence corpus fixture  \n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/session/begin",
        "body": {
          "session_id": "11111111-1111-4111-8111-111111111111",
          "read_set": [
            "docs/plan.md",
            "docs/spec.md"
          ]
        },
        "capture": {
          "token": "session_token"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/session/commit_all",
    "body": {
      "session_id": "11111111-1111-4111-8111-111111111111",
      "session_token": "${token}",
      "writes": [
        {
          "path": "docs/plan.md",
          "content": "# plan v2\n"
        },
        {
          "path": "docs/spec.md",
          "content": "# spec v2\n"
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true,
      "versions": {
        "docs/plan.md": 2,
        "docs/spec.md": 2
      },
      "coordinator_epoch": "<MINTED>"
    }
  },
  "backends": [
    "python"
  ]
}
