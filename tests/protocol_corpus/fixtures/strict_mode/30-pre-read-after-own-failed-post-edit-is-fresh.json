{
  "name": "pre-read-after-own-failed-post-edit-is-fresh",
  "description": "A session keeps a read of a file when it reports a failed edit (#513). Session A reads notes.md (v1) and pre-edits it, so it holds EXCLUSIVE; the tool then fails and the post-edit reports success:false with no content_hash, which releases the grant without a version bump. A's next Read is fresh: it is a reader of v1, the version it read. Before, the failure report left A INVALID and this read was denied on every retry, with no other session involved. Both backends.",
  "setup": {
    "tracked": [
      "notes.md"
    ],
    "strict_mode": [
      "notes.md"
    ],
    "files": {
      "notes.md": "# Notes\nv2 content\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md",
          "content_hash": "9a1c15bdf42246dcba3499756541cdbae4ed36a10dc7c584084e447ba4a00afa"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md",
          "success": false
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-read",
    "body": {
      "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
      "path": "notes.md",
      "content_hash": "9a1c15bdf42246dcba3499756541cdbae4ed36a10dc7c584084e447ba4a00afa"
    }
  },
  "optional_keys": [
    "version"
  ],
  "expected": {
    "status": 200,
    "body": {
      "status": "fresh"
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
