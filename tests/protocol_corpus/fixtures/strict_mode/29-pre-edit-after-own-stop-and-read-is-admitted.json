{
  "name": "pre-edit-after-own-stop-and-read-is-admitted",
  "description": "A session can edit a file again on its next turn (#513). Session A reads notes.md (v1), pre-edits it and commits v2, its turn ends (session-stop), and on its next turn it reads notes.md and then edits it. The edit is admitted with the bare {ok:true}: A kept a read of v2, the version it last saw, so nothing about its copy is stale. Before, the stop left A INVALID and this edit was denied on every retry, with no other session involved. Row 28 pins the read on its own. The file on disk holds the bytes A commits, and every hash in this row is theirs, so the edit's disk check finds nothing changed outside the coordinator. Both backends.",
  "setup": {
    "tracked": [
      "notes.md"
    ],
    "strict_mode": [
      "notes.md"
    ],
    "files": {
      "notes.md": "# Notes\nv2 content\n"
    },
    "preflight_requests": [
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md",
          "content_hash": "9a1c15bdf42246dcba3499756541cdbae4ed36a10dc7c584084e447ba4a00afa"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-edit",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/post-edit",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md",
          "success": true,
          "content_hash": "9a1c15bdf42246dcba3499756541cdbae4ed36a10dc7c584084e447ba4a00afa"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/session-stop",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001"
        }
      },
      {
        "method": "POST",
        "path": "/hooks/pre-read",
        "body": {
          "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
          "path": "notes.md",
          "content_hash": "9a1c15bdf42246dcba3499756541cdbae4ed36a10dc7c584084e447ba4a00afa"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/hooks/pre-edit",
    "body": {
      "session_id": "aaaaaaaa-0000-4000-8000-000000000001",
      "path": "notes.md"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "ok": true
    }
  },
  "backends": [
    "python",
    "node"
  ]
}
